# Copy to .env for local development. NEVER commit a real .env file.

# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Local development defaults to SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgresql://qvs:qvs@localhost:5432/qvs

# Session and security
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=30
PASSWORD_MIN_LENGTH=12
RATELIMIT_ENABLED=true
RATELIMIT_LOGIN=10 per minute
RATELIMIT_VERIFY=30 per minute

# Pagination
ITEMS_PER_PAGE=10

# Logging
LOG_TO_FILE=false

# Demo seeding (optional). If unset, `flask seed-demo` generates strong
# random passwords and prints them once.
# SEED_ADMIN_PASSWORD=
# SEED_ISSUER_PASSWORD=
# SEED_VERIFIER_PASSWORD=
